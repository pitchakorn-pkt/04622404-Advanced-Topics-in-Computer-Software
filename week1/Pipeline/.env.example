# Copy this file to Pipeline/.env and fill in the keys you need.
# Pipeline/.env is gitignored and must never be committed.

# Answering questions. Free key from https://console.groq.com/keys
# Needed by main.py and 06_vector_store.py, unless they are run with --no-llm.
GROQ_API_KEY=

# Embedding runs locally by default and needs no key at all. These are only
# for --provider gemini / --provider openai.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

OPENAI_API_KEY=
