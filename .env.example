# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — .env ห้าม commit เด็ดขาด
#   cp .env.example .env

# ---- ทั่วไป ----------------------------------------------------------------
LOG_LEVEL=INFO
TZ=Asia/Bangkok

# ---- LLM: Groq เป็นหลัก เจ้าอื่นเป็นตัวสำรอง -------------------------------
# ทุกเจ้าเรียกผ่านไลบรารี openai ตัวเดียวกัน สลับด้วย base_url (ดู CONTRACT ข้อ 7)
LLM_PRIMARY=groq
LLM_FALLBACK=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- URL ภายใน docker network ----------------------------------------------
# ใช้ชื่อ service ของ compose ห้ามใช้ localhost เพราะแต่ละ container มี localhost ของตัวเอง
API_URL=http://api:8000
ROUTER_URL=http://router:8000
ENGINES_URL=http://engines:8000
RETRIEVAL_URL=http://retrieval:8000
GENERATION_URL=http://generation:8000
RESPONSE_LOG_URL=http://response-log:8000

# ---- ฐานข้อมูล --------------------------------------------------------------
POSTGRES_USER=chuayduay
POSTGRES_PASSWORD=chuayduay
POSTGRES_DB=chuayduay
DATABASE_URL=postgresql+psycopg://chuayduay:chuayduay@postgres:5432/chuayduay

# ---- 02 api -----------------------------------------------------------------
JWT_SECRET_KEY=เปลี่ยนค่านี้ก่อนใช้จริง
JWT_EXPIRE_MINUTES=480
MAX_UPLOAD_MB=10

# ---- 05 retrieval -----------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
INDEX_DIR=/data/index
HF_HOME=/models

# ---- 06 generation ----------------------------------------------------------
GENERATION_TEMPERATURE=0.3
MAX_OUTPUT_TOKENS=1024
MODERATION_ENABLED=true
